// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum STATUS {
  success
  failed
  paused
  skiped
  running
  pending
}

model user {
  id               Int                @id @default(autoincrement())
  firstName        String
  lastName         String
  username         String             @unique
  email            String             @unique
  password         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  group            group[]            @relation("group_users")
  container        container[]
  workflowTemplate workflowTemplate[]
  workflow         workflow[]
  project          project[]          @relation("project_owner")
  projects         project[]          @relation("project_users")
  groups           group[]            @relation("group_owner")
}

model project {
  id               Int                @id @default(autoincrement())
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            user?              @relation("project_owner", fields: [userId], references: [id])
  userId           Int
  group            group[]
  users            user[]             @relation("project_users")
  container        container[]
  workflowTemplate workflowTemplate[]
  workflow         workflow[]
}

model group {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       user?     @relation("group_owner", fields: [userId], references: [id])
  userId      Int
  user        user[]    @relation("group_users")
  project     project[]
}

model container {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  image        String
  commands     String[]
  envs         String[]
  workingDir   String[]
  user         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobtemplates jobTemplate[]
  jobs         job[]
  owner        user?         @relation(fields: [userId], references: [id])
  userId       Int?
  project      project?      @relation(fields: [projectId], references: [id])
  projectId    Int?
}

model workflowTemplate {
  id           Int                     @id @default(autoincrement())
  name         String                  @unique
  jobTemplates jobTemplate[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  initJob      String                  @default("init")
  placements   Json?
  workflows    workflow[]
  owner        user?                   @relation(fields: [userId], references: [id])
  userId       Int?
  project      project?                @relation(fields: [projectId], references: [id])
  projectId    Int?
  parameters   workflowTemplateParam[]

  @@map("workflow_template")
}

model workflowTemplateParam {
  id                 Int              @id @default(autoincrement())
  name               String
  workflowTemplate   workflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  workflowTemplateId Int
  required           Boolean          @default(false)
  default            String           @default("")
}

model workflowParam {
  id         Int      @id @default(autoincrement())
  name       String
  value      String
  workflow   workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId Int
}

model jobTemplate {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  container          container?        @relation(fields: [containerId], references: [id])
  containerId        Int?
  successors         String[]
  dependencies       String[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workflowTemplate   workflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  workflowTemplateId Int?
  jobs               job[]
  outputParams       outputParams[]
  inputParams        inputParams[]
  condition          String?

  @@map("job_template")
}

model outputParams {
  id                Int                 @id @default(autoincrement())
  name              String
  path              String
  jobTemplate       jobTemplate?        @relation(fields: [jobTemplateId], references: [id], onDelete: Cascade)
  jobTemplateId     Int?
  outputParamsValue outputParamsValue[]
  inputParams       inputParams[]
}

model inputParams {
  id             Int          @id @default(autoincrement())
  name           String?
  jobTemplate    jobTemplate? @relation(fields: [jobTemplateId], references: [id])
  jobTemplateId  Int?
  outputParams   outputParams @relation(fields: [outputParamsId], references: [id])
  outputParamsId Int
}

model outputParamsValue {
  id             Int          @id @default(autoincrement())
  value          String
  outputParams   outputParams @relation(fields: [outputParamsId], references: [id])
  outputParamsId Int
  job            job?         @relation(fields: [jobId], references: [id])
  jobId          Int?
  workflowId     Int
}

model workflow {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  jobs               job[]
  totalJobs          Int               @default(0)
  completedJobs      Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  startedAt          DateTime?
  finishedAt         DateTime?
  status             STATUS            @default(pending)
  placements         Json?
  workflowTemplate   workflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  workflowTemplateId Int?
  jidsMap            Json?
  owner              user?             @relation(fields: [userId], references: [id])
  userId             Int?
  project            project?          @relation(fields: [projectId], references: [id])
  projectId          Int?
  workflowParam      workflowParam[]
}

model job {
  id                Int                 @id @default(autoincrement())
  name              String
  status            STATUS              @default(pending)
  successors        String[]            @default([])
  dependencies      String[]            @default([])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?
  workflow          workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId        Int
  jobTemplate       jobTemplate?        @relation(fields: [jobTemplateId], references: [id])
  jobTemplateId     Int?
  container         container?          @relation(fields: [containerId], references: [id])
  containerId       Int?
  exitCode          Int?
  containerInstance String?
  outputParamsValue outputParamsValue[]
}
