// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  username  String    @unique
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  group     group[]
  project   project[]
}

model group {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      user[]
  project   project[]
}

model project {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user[]
  group     group[]
}

model container {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  image        String
  commands     String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobtemplates jobTemplate[]
  jobs         job[]
  owner        String?
  group        String?
}

model workflowTemplate {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  jobTemplates jobTemplate[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  initJob      String        @default("init")
  placements   Json?
  workflows    workflow[]
  owner        String?
  group        String?

  @@map("workflow_template")
}

model jobTemplate {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  container          container?        @relation(fields: [containerId], references: [id])
  containerId        Int?
  successors         String[]
  dependencies       String[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workflowTemplate   workflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  workflowTemplateId Int?
  jobs               job[]

  @@map("job_template")
}

model workflow {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  jobs               job[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  status             String            @default("pending")
  placements         Json?
  workflowTemplate   workflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  workflowTemplateId Int?
  jidsMap            Json?
  owner              String?
  group              String?
}

model job {
  id            Int          @id @default(autoincrement())
  name          String
  status        String       @default("pending")
  successors    String[]     @default([])
  dependencies  String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workflow      workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId    Int
  jobTemplate   jobTemplate? @relation(fields: [jobTemplateId], references: [id])
  jobTemplateId Int?
  container     container?   @relation(fields: [containerId], references: [id])
  containerId   Int?
  owner         String?
  group         String?
}
