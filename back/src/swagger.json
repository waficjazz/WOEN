{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "My Express API"
  },
  "basePath": "/api/v1",
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/user/login": {
      "post": {
        "summary": "Login",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserLogin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/workflow/init": {
      "post": {
        "summary": "Init Workflow",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/WorkflowInit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "definitions": {
    "UserLogin": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "WorkflowInit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "temolateName": {
          "type": "string"
        },
        "projectId": {
          "type": "integer"
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
