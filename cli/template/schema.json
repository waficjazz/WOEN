{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["template", "workflow"]
    },
    "name": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/param"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/job"
      }
    }
  },
  "required": ["name", "jobs"],
  "definitions": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "container"],
      "properties": {
        "name": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/output"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/input"
          }
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["image", "name"]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["name", "path"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      },
      "required": ["name", "from"]
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "default": {
          "type": ["string", "number", "boolean", "array", "object"]
        }
      },
      "required": ["name"]
    }
  }
}
